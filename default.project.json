    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "TrainTap": { "$className": "RemoteEvent" },
        "ThrowStart": { "$className": "RemoteEvent" },
        "ThrowRelease": { "$className": "RemoteEvent" },
        "SetAutoLaunch": { "$className": "RemoteEvent" },
        "BuyUpgrade": { "$className": "RemoteEvent" },
        "RequestPurchase": { "$className": "RemoteEvent" },
        "OpenFreeEgg": { "$className": "RemoteEvent" },
